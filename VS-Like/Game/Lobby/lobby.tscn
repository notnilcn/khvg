[gd_scene load_steps=2 format=3 uid="uid://lobby_scene_001"]

[ext_resource type="Script" path="res://VS-Like/Game/Lobby/lobby.gd" id="1_lobby"]

[node name="Lobby" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
